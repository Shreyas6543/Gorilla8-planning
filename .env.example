# Copy this to .env.local (gitignored, never committed) and fill in your own values.

# Gates editing on the Expenses page — without it (or with the default),
# anyone can view the page but only someone with the passcode can edit it.
VITE_EDIT_PASSCODE=change-me

# Supabase project — Settings -> API in your Supabase dashboard.
# Use the publishable/anon key here, NEVER the secret/service_role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
