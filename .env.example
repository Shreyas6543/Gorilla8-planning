# Copy this to .env.local (gitignored, never committed) and fill in your own values.

# Gates editing site-wide (Expenses, Design publishing, etc.) — someone
# who has this can also view every internal page (editing implies viewing).
VITE_EDIT_PASSCODE=change-me

# Gates VIEWING every internal/business page (Home, Expenses, Ledger,
# Finance, Marketing, Floor Plan, Design, Walkthrough, QR Scans). Separate
# from VITE_EDIT_PASSCODE on purpose: share this one with partners who need
# to see the numbers but shouldn't need (or have) the edit passcode.
# Without it, anyone who isn't unlocked gets bounced to /coming-soon —
# including a customer who scans a banner QR and strips the URL back to the
# domain root. Enter it at /team.
VITE_VIEW_PASSCODE=change-me-too

# Supabase project — Settings -> API in your Supabase dashboard.
# Use the publishable/anon key here, NEVER the secret/service_role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
